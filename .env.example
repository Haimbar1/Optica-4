# The site is the "site" module of the SmartEsek portal (portal.smartesek.com). Its keys belong in
# the portal: אתר ← מזהים וחיבורים. While moving over, a value set here still wins; anything not set
# here is read from the portal — so a key can be entered there and then deleted here.

# The platform's shared secret (same value as the other apps). The only one that must stay here:
# it is what unlocks the portal's vault.
SSO_SHARED_SECRET=

# Moving to the portal (leave empty once entered there):
# Gemini key for the site's AI chat (the shared AI field in the portal)
GEMINI_API_KEY=
# The business's CRM API key (X-Tenant-Key) for sending leads from the site
SMARTESEK_TENANT_KEY=
