# Gemini API Key for server-side AI chat fallback
GEMINI_API_KEY=

# SmartEsek CRM Public Lead Key
SMARTESEK_LEAD_KEY=1234512345
SMARTESEK_TENANT_KEY=

# The site is the "site" module of the SmartEsek portal: try-on frames are managed there, and keys
# can be entered in its vault ("מזהים וחיבורים") instead of here. Vercel values still come first.
PORTAL_URL=https://portal.smartesek.com
PORTAL_TENANT_ID=1
# Platform-wide shared secret (same as the other apps) — only needed to read keys from the vault
SSO_SHARED_SECRET=
